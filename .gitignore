.DS_Store
._*
.idea/
.vscode/
*.swp
*.swo
*.zip
node_modules/
vendor/
wp-config.php
wp-content/uploads/
# SVN deploy
.svn-credentials.sh
.svn-working-copy/
MANUAL-deploy-svn.sh

# Local deploy tooling
build.sh
deploy-wordpress.sh
backup-s3.sh
purge-cloudflare.sh
rollback-wordpress.sh
.claude/
.claude-flow/
crash-remove.sh
crash-logs/
_archive/
WORKING-NOTES.md

# Help docs generator
generate-help-docs.sh
docs/screenshots/
.env.test
tests/auth.json
tests/.env

# Playwright test artifacts
tests/test-results/
# The whole HTML report, index.html included. Only its data/ blobs were ignored, and
# index.html plus test-results/.last-run.json had been committed before the rules
# existed, so every test run left the tree dirty and every deploy warned about
# "uncommitted files" that were only the last run's output.
tests/playwright-report/

# Playwright MCP scratch output (page snapshots, console logs, downloaded fixtures).
.playwright-mcp/

# oh-my-claudecode session state (project-memory.json, state/). Tooling scratch,
# not project work, and untracked-but-unignored is how it lands in a `git add -A`.
.omc/

# Deploy records beside each archived zip, written by shared-build-tools/record-uncommitted.sh.
# Local recovery data like the zips themselves; never committed.
archive/*.manifest.txt
archive/*.uncommitted.patch
archive/*.untracked.tgz
